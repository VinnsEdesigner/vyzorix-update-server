
# Server
PORT=3000
NODE_ENV=development
DATABASE_URL=./data/vyzorix.db
VYZORIX_API_DIR=./data
VYZORIX_BIN_DIR=./bin
VYZORIX_PUBLIC_DIR=./public

# Security
API_KEY_primary=dev-api-key-primary-replace-in-production
API_KEY_backup=dev-api-key-backup-replace-in-production
API_KEY_PREFIX=vxyz
SERVER_API_TOKEN=dev-dashboard-token-secret-replace-in-production-min32chars
JWT_SECRET=dev-jwt-secret-replace-in-production-min32chars-longer
JWT_DURATION_HOURS=168
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
ENFORCE_HMAC=false
HMAC_WINDOW_SECONDS=30

# Deployment URLs
BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# ─── Client-Side Configuration (Vite Environment Variables) ───────────────────
# REST API base URL — routes through the proxy which strips /api prefix
VITE_API_URL=/api
# WebSocket URL — leave unset to auto-detect the proxy host from window.location.
# When unset, the API client uses ws(s)://<window.location.host>/v1/device so
# WS connections route through the proxy (which forwards to the Go API).
# VITE_WS_URL=ws://localhost:3099/v1/device
# REST Client Configuration
VITE_REST_TIMEOUT=30000
VITE_REST_WITH_CREDENTIALS=true
# WebSocket Configuration
VITE_WS_RECONNECT_INTERVAL=3000
VITE_WS_RECONNECT_MAX_DELAY=30000
VITE_WS_RECONNECT_MULTIPLIER=2
VITE_WS_MAX_RECONNECT_ATTEMPTS=5
VITE_WS_HEARTBEAT_INTERVAL=30000
VITE_WS_HEARTBEAT_TIMEOUT=10000
# Metrics Configuration
VITE_METRICS_DEFAULT_LIMIT=500
VITE_METRICS_RETENTION_DAYS=30
