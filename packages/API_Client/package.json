{
  "name": "@vyzorix/api-client",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "browser": "./src/index.ts",
      "node": "./src/node.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./node": {
      "types": "./src/node.ts",
      "default": "./src/node.ts"
    },
    "./domain": "./src/domain/index.ts",
    "./vyzorServer": "./src/vyzorServer/index.ts",
    "./generated": "./src/generated/rest-bridge.ts",
    "./generated/*": "./src/generated/*",
    "./generated-graphql": "./src/generated/graphql/index.ts",
    "./generated/auth": "./src/generated/auth/auth.ts",
    "./generated/mfa": "./src/generated/mfa/mfa.ts",
    "./generated/devices": "./src/generated/devices/devices.ts",
    "./generated/commands": "./src/generated/commands/commands.ts",
    "./generated/updates": "./src/generated/updates/updates.ts",
    "./generated/inbox": "./src/generated/inbox/inbox.ts",
    "./generated/organizations": "./src/generated/organizations/organizations.ts",
    "./generated/members": "./src/generated/members/members.ts",
    "./generated/invitations": "./src/generated/invitations/invitations.ts",
    "./generated/settings": "./src/generated/settings/settings.ts",
    "./generated/sessions": "./src/generated/sessions/sessions.ts",
    "./generated/admin": "./src/generated/admin/admin.ts",
    "./generated/api-keys": "./src/generated/api-keys/api-keys.ts",
    "./generated/client-credentials": "./src/generated/client-credentials/client-credentials.ts",
    "./generated/service-accounts": "./src/generated/service-accounts/service-accounts.ts",
    "./generated/contact-points": "./src/generated/contact-points/contact-points.ts",
    "./generated/alerts": "./src/generated/alerts/alerts.ts",
    "./generated/dashboard": "./src/generated/dashboard/dashboard.ts",
    "./generated/diagnostics": "./src/generated/diagnostics/diagnostics.ts",
    "./generated/connections": "./src/generated/connections/connections.ts",
    "./generated/telemetry": "./src/generated/telemetry/telemetry.ts",
    "./generated/updater": "./src/generated/updater/updater.ts"
  },
  "scripts": {
    "build": "tsup src/index.ts src/node.ts --format cjs,esm",
    "build:dts": "tsc --emitDeclarationOnly -p tsconfig.dts.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix"
  },
  "dependencies": {
    "@apollo/client": "^3.11.0",
    "axios": "^1.6.8",
    "graphql": "^16.8.1",
    "graphql-ws": "^5.15.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@react-native-community/netinfo": "^12.0.1",
    "@types/node": "^20.11.0",
    "@types/react": "^19.2.17",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^10.7.0",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5"
  },
  "peerDependencies": {
    "react": ">=18.2.0"
  }
}