{
  "name": "@vyzorix/api-client",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "browser": "./src/index.ts",
      "node": "./src/node.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./node": {
      "types": "./src/node.ts",
      "default": "./src/node.ts"
    },
    "./domain": "./src/domain/index.ts",
    "./vyzorServer": "./src/vyzorServer/index.ts"
  },
  "scripts": {
    "build": "tsup src/index.ts src/node.ts --format cjs,esm",
    "build:dts": "tsc --emitDeclarationOnly -p tsconfig.dts.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix"
  },
  "dependencies": {
    "@apollo/client": "^3.11.0",
    "axios": "^1.6.8",
    "graphql": "^16.8.1",
    "graphql-ws": "^5.15.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@react-native-community/netinfo": "^12.0.1",
    "@types/node": "^20.11.0",
    "@types/react": "^19.2.17",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^10.7.0",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5"
  },
  "peerDependencies": {
    "react": ">=18.2.0"
  }
}
