# Simple Dockerfile for Go server only (no web/SSR)
FROM golang:1.26-alpine AS builder

# Install build dependencies for CGO (sqlite3)
RUN apk add --no-cache gcc musl-dev

WORKDIR /app

# Copy dependency files first for better layer caching
COPY apps/api/go.mod apps/api/go.sum ./
RUN go mod download

# Copy source and build
COPY apps/api ./

# Build the Go server
RUN CGO_ENABLED=1 GOOS=linux go build \
    -trimpath \
    -ldflags="-s -w" \
    -o /vyzorix-update-server ./cmd/api

# Final stage
FROM alpine:3.19

# Install runtime dependencies
RUN apk add --no-cache ca-certificates sqlite-libs curl

WORKDIR /app

# Copy binary from builder
COPY --from=builder /vyzorix-update-server .
COPY --from=builder /app/data ./data

# Create data directory
RUN mkdir -p /app/data

# Environment
ENV PORT=3000 \
    DATABASE_URL=/app/data/vyzorix.db \
    VYZORIX_API_DIR=/app/data \
    VYZORIX_BIN_DIR=/app/bin \
    VYZORIX_PUBLIC_DIR=/app/public

# Expose port
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:3000/health || exit 1

# Run
ENTRYPOINT ["/app/vyzorix-update-server"]
