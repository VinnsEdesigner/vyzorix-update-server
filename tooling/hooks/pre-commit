#!/usr/bin/env bash
# Pre-commit hook — go build, go vet, golangci-lint via go tool.
# Auto-activated by: tooling/git wrapper or bash tooling/setup.sh
# golangci-lint is a Go tool dependency — no separate install needed.
# Bypass: git commit --no-verify (Server Gate CI is the backstop)

set -euo pipefail

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; NC='\033[0m'
fail() { echo -e "${RED}[pre-commit] $1${NC}"; exit 1; }
pass() { echo -e "${GREEN}[pre-commit] $1${NC}"; }
info() { echo -e "${YELLOW}[pre-commit] $1${NC}"; }

STAGED_GO=$(git diff --cached --name-only --diff-filter=ACM -- 'apps/api/*.go' | head -1)
if [ -z "$STAGED_GO" ]; then exit 0; fi

info "Go files staged — running server gate..."
REPO_ROOT=$(git rev-parse --show-toplevel)
API_DIR="$REPO_ROOT/apps/api"

if ! command -v go &>/dev/null; then
  fail "Go is not installed. Install Go 1.26+ or use --no-verify."
fi

cd "$API_DIR"

info "Running go build..."
go build ./... 2>&1 || fail "go build failed."
pass "go build: clean"

info "Running go vet..."
go vet ./... 2>&1 || fail "go vet found issues."
pass "go vet: clean"

info "Running golangci-lint (go tool)..."
if ! go tool golangci-lint run --timeout=5m ./... 2>&1; then
  echo -e "${RED}[pre-commit] golangci-lint found issues.${NC}"
  echo -e "${YELLOW}[pre-commit] Commit blocked. Bypass: git commit --no-verify${NC}"
  exit 1
fi
pass "golangci-lint: clean"
echo ""
pass "All checks passed. Commit proceeding."
// trigger
