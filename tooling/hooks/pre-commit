#!/usr/bin/env bash
#
# pre-commit hook — runs golangci-lint v2.12.2 before the commit goes through.
#
# If any staged .go file under apps/api/ has issues, the commit is blocked.
# The hook also runs `go build` and `go vet` as a fast first pass.
#
# Install:
#   cp tooling/hooks/pre-commit .git/hooks/pre-commit
#   chmod +x .git/hooks/pre-commit
#
# Or use the installer:
#   bash tooling/hooks/install.sh
#
# Skip for a single commit (emergency):
#   git commit --no-verify
#
# Requirements:
#   - Go 1.26+ installed and on PATH
#   - golangci-lint v2.12.2 installed (https://golangci-lint.run/usage/install/)

set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

fail()   { echo -e "${RED}[pre-commit] $1${NC}"; exit 1; }
pass()   { echo -e "${GREEN}[pre-commit] $1${NC}"; }
info()   { echo -e "${YELLOW}[pre-commit] $1${NC}"; }

# Only run if Go files are staged
STAGED_GO=$(git diff --cached --name-only --diff-filter=ACM -- 'apps/api/*.go' | head -1)
if [ -z "$STAGED_GO" ]; then
  exit 0
fi

info "Go files staged — running server gate..."

REPO_ROOT=$(git rev-parse --show-toplevel)
API_DIR="$REPO_ROOT/apps/api"

if ! command -v go &>/dev/null; then
  fail "Go is not installed or not on PATH. Install Go 1.26+ or use --no-verify to skip."
fi

if ! command -v golangci-lint &>/dev/null; then
  fail "golangci-lint is not installed. Install v2.12.2:
  curl -sSfL https://raw.githubusercontent.com/golangci/golangci-lint/master/install.sh | sh -s -- -b \$(go env GOPATH)/bin v2.12.2
Or use --no-verify to skip."
fi

LINT_VERSION=$(golangci-lint version 2>&1 | head -1 | grep -oE 'v?[0-9]+\.[0-9]+\.[0-9]+' || echo "unknown")
info "golangci-lint version: $LINT_VERSION"

cd "$API_DIR"

# Step 1: go build
info "Running go build..."
if ! go build ./... 2>&1; then
  fail "go build failed. Fix compile errors and retry."
fi
pass "go build: clean"

# Step 2: go vet
info "Running go vet..."
if ! go vet ./... 2>&1; then
  fail "go vet found issues. Fix them and retry."
fi
pass "go vet: clean"

# Step 3: golangci-lint
info "Running golangci-lint..."
if ! golangci-lint run --timeout=5m ./... 2>&1; then
  echo ""
  echo -e "${RED}[pre-commit] golangci-lint found issues above.${NC}"
  echo -e "${YELLOW}[pre-commit] The commit has been blocked.${NC}"
  echo -e "${YELLOW}[pre-commit] Fix the issues and run 'git commit' again.${NC}"
  echo -e "${YELLOW}[pre-commit] To bypass (not recommended): git commit --no-verify${NC}"
  exit 1
fi
pass "golangci-lint: clean"

echo ""
pass "All checks passed. Commit proceeding."
