# ═══════════════════════════════════════════════════════════════════════════════
# VYZORIX UPDATE SERVER — PRODUCTION ENVIRONMENT CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env when deploying to production.
# IMPORTANT: Generate all secrets with: openssl rand -hex 32

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
DATABASE_URL=/app/data/vyzorix.db
VYZORIX_API_DIR=/app/data
VYZORIX_BIN_DIR=/app/bin
VYZORIX_PUBLIC_DIR=/app/public

# ─── Security ────────────────────────────────────────────────────────────────
# REQUIRED: API Keys for accessing all endpoints except /health and /healthz
# Generate with: openssl rand -hex 32
API_KEY_primary=YOUR_PRIMARY_API_KEY_HERE
API_KEY_backup=YOUR_BACKUP_API_KEY_HERE
API_KEY_PREFIX=vxyz

# Server API token for internal dashboard
SERVER_API_TOKEN=YOUR_SERVER_API_TOKEN_HERE

# JWT configuration
JWT_SECRET=YOUR_JWT_SECRET_MUST_BE_32_PLUS_CHARS
JWT_DURATION_HOURS=168

# Session configuration
SESSION_SECRET=YOUR_SESSION_SECRET_MUST_BE_32_PLUS_CHARS
SESSION_MAX_AGE_SECONDS=604800

# CORS
ALLOWED_ORIGINS=https://your-dashboard.example.com,android-app://com.vyzorix.audiorouter

# HMAC Enforcement
ENFORCE_HMAC=true
HMAC_WINDOW_SECONDS=30

# ─── Firebase (FCM Push Notifications) ───────────────────────────────────────
FIREBASE_CREDENTIALS=

# ─── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ─── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=Vyzorix
EMAIL_VERIFY_TOKEN_EXPIRY_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRY_MINUTES=60

# ─── Deployment URLs ───────────────────────────────────────────────────────────
BASE_URL=https://api.yourdomain.com
FRONTEND_URL=https://your-dashboard.example.com

# ─── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MIN=100
AUTH_RATE_LIMIT_MIN=10

# ─── Device Management ─────────────────────────────────────────────────────────
DEVICE_DELETION_ENABLED=false
DEVICE_DELETION_INTERVAL_MINUTES=5

# ─── Audit Logging ─────────────────────────────────────────────────────────────
AUDIT_LOG_SEPARATE_DB=true
AUDIT_LOG_SEPARATE_DB_PATH=/app/data/audit/audit.db

# ─── Diagnostics ───────────────────────────────────────────────────────────────
DIAG_OFFLINE_THRESHOLD_MINUTES=5
DIAG_FCM_TOKEN_EXPIRY_DAYS=30
DIAG_INSPECTION_CACHE_TTL_SECONDS=10
DIAG_TELEMETRY_RETENTION_DAYS=7
