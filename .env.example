# ═══════════════════════════════════════════════════════════════════════════════
# VYZORIX UPDATE SERVER — Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
# Generate secrets with: openssl rand -hex 32

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
DATABASE_URL=./data/vyzorix.db
VYZORIX_API_DIR=./data
VYZORIX_BIN_DIR=./bin
VYZORIX_PUBLIC_DIR=./public

# ─── Database Backend ─────────────────────────────────────────────────────────
# Storage backend selection. The server supports two interchangeable backends:
#
#   sqlite (default, local)  — a local file via the mattn/go-sqlite3 (CGO) driver.
#                               Use for development. DATABASE_URL is the file path.
#   turso  (production, cloud) — a remote Turso libSQL database over HTTP via the
#                               pure-Go tursodatabase/libsql-client-go driver.
#                               Use for production. Requires TURSO_DB_URL + token.
#
# DATABASE_BACKEND:
#   auto   — pick turso when TURSO_DB_URL is set, otherwise sqlite (default).
#   sqlite — force local file regardless of TURSO_DB_URL.
#   turso  — force remote Turso; TURSO_DB_URL and TURSO_AUTH_TOKEN are required.
DATABASE_BACKEND=auto

# Turso (cloud) — required only when DATABASE_BACKEND=turso (or auto with URL set).
# Get from: https://turso.io → your database → Settings → URL / Access Tokens
# Use the libsql:// scheme (https:// also accepted). http:// is rejected in prod.
TURSO_DB_URL=
TURSO_AUTH_TOKEN=

# Connection pool tuning (mostly relevant for the Turso backend; SQLite is pinned
# to a single writer). All accept Go duration strings like "30s", "5m", "1h".
DATABASE_MAX_OPEN_CONNS=16
DATABASE_MAX_IDLE_CONNS=8
DATABASE_CONN_MAX_LIFETIME=30m
DATABASE_CONN_MAX_IDLE_TIME=5m
DATABASE_REQUEST_TIMEOUT=15s
# Background pool health-check interval (Turso only). 0 disables. Default: 30s.
DATABASE_HEALTH_CHECK_PERIOD=30s

# ─── Security ────────────────────────────────────────────────────────────────
# REQUIRED: API Keys for accessing all endpoints except /health and /healthz
# Generate with: openssl rand -hex 32
# Supports multiple keys for rotation - all keys are valid simultaneously
# Format: API_KEY_<id>=<key_value>
API_KEY_primary=replace-with-a-random-64-character-api-key
API_KEY_backup=replace-with-another-random-64-character-key-for-rotation
# Optional: Prefix for key identification in logs (e.g., "vxyz")
API_KEY_PREFIX=vxyz
SERVER_API_TOKEN=replace-with-a-random-32-plus-character-dashboard-token
JWT_SECRET=replace-with-a-different-random-32-plus-character-jwt-secret
JWT_DURATION_HOURS=168
ALLOWED_ORIGINS=http://localhost:5173,https://your-dashboard.example.com,android-app://com.vyzorix.audiorouter
ENFORCE_HMAC=true
HMAC_WINDOW_SECONDS=30

# ─── Firebase (FCM Push Notifications) ───────────────────────────────────────
# Get from: Firebase Console → Project Settings → Service Accounts → Generate
FIREBASE_CREDENTIALS={"type":"service_account","project_id":"","private_key_id":"","private_key":"","client_email":"","client_id":"","auth_uri":"","token_uri":"","auth_provider_x509_cert_url":"","client_x509_cert_url":""}

# ─── Google OAuth (Optional) ───────────────────────────────────────────────────
# Get from: Google Cloud Console → APIs & Services → Credentials
# Create an OAuth 2.0 Client ID (Web application type).
# Add callback URL: https://your-domain.com/v1/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ─── Email (Resend) ───────────────────────────────────────────────────────────
# Get from: https://resend.com API Keys
# Leave empty to disable email verification and password reset.
RESEND_API_KEY=
EMAIL_FROM=noreply@vyzorix.app
EMAIL_FROM_NAME=Vyzorix
EMAIL_VERIFY_TOKEN_EXPIRY_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRY_MINUTES=60

# ─── Deployment URLs ───────────────────────────────────────────────────────────
# Base URL of this Go server (used to construct OAuth callback URLs)
BASE_URL=http://localhost:3000
# Frontend URL — used to redirect after OAuth flow
FRONTEND_URL=http://localhost:5173

# ─── Startup Behavior ──────────────────────────────────────────────────────────
# AUTO_OPEN_BROWSER - Set to "false" or "0" to disable auto-opening browser
AUTO_OPEN_BROWSER=true
# BUILD_MODE - Set to "development" or "production" (default: production)
BUILD_MODE=production

# ═══════════════════════════════════════════════════════════════════════════════
# CLIENT-SIDE CONFIGURATION (Vite Environment Variables)
# These are used by the frontend API Client package
# Prefix: VITE_ for client-side exposure
# ═══════════════════════════════════════════════════════════════════════════════

# ─── API & Server URLs ─────────────────────────────────────────────────────────
# REST API base URL — routes through the proxy which strips /api prefix
VITE_API_URL=/api
# WebSocket URL — leave unset to auto-detect the proxy host from window.location.
# When unset, the API client uses ws(s)://<window.location.host>/v1/device so
# WS connections route through the proxy (which forwards to the Go API).
# VITE_WS_URL=ws://localhost:3099/v1/device

# ─── REST Client Configuration ────────────────────────────────────────────────
# Request timeout in milliseconds (default: 30000 = 30 seconds)
VITE_REST_TIMEOUT=30000
# Include credentials (cookies) in cross-origin requests
VITE_REST_WITH_CREDENTIALS=true

# ─── WebSocket Configuration ───────────────────────────────────────────────────
# Reconnection settings
VITE_WS_RECONNECT_INTERVAL=3000
VITE_WS_RECONNECT_MAX_DELAY=30000
VITE_WS_RECONNECT_MULTIPLIER=2
VITE_WS_MAX_RECONNECT_ATTEMPTS=5
# Heartbeat settings
VITE_WS_HEARTBEAT_INTERVAL=30000
VITE_WS_HEARTBEAT_TIMEOUT=10000

# ─── Metrics Configuration ─────────────────────────────────────────────────────
# Default limit for telemetry history requests
VITE_METRICS_DEFAULT_LIMIT=500
# Data retention period in days (for client-side caching reference)
VITE_METRICS_RETENTION_DAYS=30

# ─── Product Analytics (PostHog) ────────────────────────────────────────────────
# Anonymous usage analytics. Disabled by default; enable in production.
# Leave VITE_ANALYTICS_KEY empty to disable analytics entirely.
#
# VITE_ANALYTICS_ENABLED:
#   true  — analytics active (subject to user consent + do-not-track).
#   false — analytics fully disabled regardless of key (default).
# VITE_ANALYTICS_KEY   — PostHog project API key (public, safe to expose).
# VITE_ANALYTICS_HOST   — PostHog host (e.g. https://app.posthog.com or self-hosted).
# VITE_DO_NOT_TRACK     — set to "true" to honour Do-Not-Track even if user consents.
VITE_ANALYTICS_ENABLED=false
VITE_ANALYTICS_KEY=
VITE_ANALYTICS_HOST=https://app.posthog.com
VITE_DO_NOT_TRACK=false


# ─── Feature Toggles ───────────────────────────────────────────────────────────
# All features default to ON. Set to "false" to disable individually.
# FEATURE_SCOPED_RBAC     — scoped permission engine (action+scope evaluation)
# FEATURE_DEVICE_GROUPS   — team/device-group-based device access
# FEATURE_SERVER_DRIVEN_ORG — server-side org resolution (session/key authoritative)
# FEATURE_ACTION_SETS     — aggregate-action expansion in the permission evaluator
# FEATURE_SCOPE_RESOLVERS — attribute-scope resolution (devices:imei:X → concrete)
# FEATURE_PERMISSION_CACHE — in-memory permission-resolution cache (30s TTL)
FEATURE_SCOPED_RBAC=true
FEATURE_DEVICE_GROUPS=true
FEATURE_SERVER_DRIVEN_ORG=true
FEATURE_ACTION_SETS=true
FEATURE_SCOPE_RESOLVERS=true
FEATURE_PERMISSION_CACHE=true
